//然后其他多于情况也没问题，至于这里的表达式是先算b，之后再用新的b和a运算找规律的。
int singleNumber(vector<int>& nums) {
        int a = 0, b = 0;
        for(auto e : nums){
            b = (~a)&(b^e);//!是输出0，0输出1.~是按位取反
            a = (~b)&(a^e);
        }
        return b;
    }
