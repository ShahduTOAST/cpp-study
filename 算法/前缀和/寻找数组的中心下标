//https://leetcode.cn/problems/find-pivot-index/

class Solution {
public:
// 思路的话，用前缀和数组直接判断，时间复杂度是n
//判断方式为检测i之气那和i之后的和是否相同
    int pivotIndex(vector<int>& nums) {
        //求前缀和数组
        int n = nums.size();
        vector<int> dp(n + 1);
        for(int i = 1; i <= n; i++){
            dp[i] = dp[i - 1] + nums[i - 1];
        }
        for(int j = 1; j <= n; j++){
            //0  x-1  |x| X+1  end
            if(dp[j - 1] == (dp[n] - dp[j])) return j - 1;
        }
        return -1;
    }
};
