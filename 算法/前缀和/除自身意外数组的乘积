//https://leetcode.cn/problems/product-of-array-except-self/

//思路：前缀和＋后缀和累乘
class Solution {
public:
    vector<int> productExceptSelf(vector<int>& nums) {
        int n = nums.size();
        vector<int> f(n), g(n);
        //预处理f，g
        f[0] = g[n - 1] = 1;

        //预处理
        for(int i = 1; i < n; i++){
            f[i] = f[i - 1] * nums[i - 1];
        }
        for(int i = n - 2; i >= 0; i--){
            g[i] = g[i + 1] * nums[i + 1];
        }
        //处理答案
        vector<int> ret(n);
        for(int i = 0; i < n; i++){
            ret[i] = f[i] * g[i];
        }
        return ret;
    }
};
