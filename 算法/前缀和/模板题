#include <iostream>
#include <vector>
using namespace std;
//思路的话，求的是一段区间，那么我们用前缀和数组就可以表达出每个区间的结果了，n m是arr[m] - arr[n - 1]
//再加个0的占位
int main() {
   //1.读入数据
   int n, q, tmp = 0;
   cin >> n >> q;
   vector<int> arr(n + 1);
        //这里用for循环是保留n不变
    for(int i = 1; i<= n; i++) cin >> arr[i];
    //2.求前缀和--这里数据溢出了，改类型
    vector<long long> dp(n+1);
    for(int i = 1; i <= n; i++) dp[i] = arr[i] + dp[i - 1];
    //3.求解
    int left = 0, right = 0;
    for(int i = 1; i <= q; i++){
        cin >> left >> right;
        cout << dp[right] - dp[left - 1] << endl;
    }
    return 0;
}
