//https://leetcode.cn/problems/missing-number/

class Solution {
public:
    int missingNumber(vector<int>& nums) {
        //位运算，即a^b^a = b,所以我们只需两个数，一个异或0到end，林一个是数组最后二者异或
        int tmp = 0, ret = 0, n = nums.size();
        for(int i = 0; i < n; i++){
            tmp ^= nums[i];
            ret ^= i;
        }
        ret = ret ^ n ^ tmp;
        return ret;
    }
};
