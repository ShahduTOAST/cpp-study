//https://leetcode.cn/problems/missing-two-lcci/submissions/756240412/
//和分组调整一样

class Solution {
public:
    vector<int> missingTwo(vector<int>& nums) {
        int diff = 0, tmp = 0, n = nums.size();
        for(auto x : nums) tmp ^=x;
        for(int i = 1; i <= n + 2; i++) tmp ^= i;
        //找不同位
        while(1){
            if(((tmp >> diff) & 1) == 1) break;
            else diff++;
        }
        //根据diff分组
        int a = 0, b = 0;
        for(auto x : nums){
            if(((x >> diff) & 1) == 1) a ^= x;
            else b ^= x;
        }
        for(int i = 1; i <= n + 2; i++){
            if(((i >> diff) & 1) == 1) a ^= i;
            else b ^= i;
        }
        return {a, b};
    }
};
