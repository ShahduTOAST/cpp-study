//https://leetcode.cn/problems/replace-all-s-to-avoid-consecutive-repeating-characters/
//简单写一下思路 和这类题，这里题目主要就是模拟实现题目表达过程，靠代码能力


class Solution {
public:
    string modifyString(string s) {
        int n = s.size();
        for(int i = 0; i < n; i++){
            if(s[i] == '?'){
                for(char ch = 'a'; ch <= 'z'; ch++){
                    if((i == 0 || ch != s[i - 1])&&(i == n-1 || ch != s[i + 1]))
                        s[i] = ch;
                }
            }
        }
        return s;
    }
};
