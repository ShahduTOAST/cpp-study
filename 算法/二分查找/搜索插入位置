//https://leetcode.cn/problems/search-insert-position/



int searchInsert(vector<int>& nums, int target) {
        int left = 0, right = nums.size() - 1, mid;
        while(left < right){
            mid = (left + right) / 2;
            if(nums[mid] < target)  left = mid + 1;
            else right = mid;
        }
        if(nums[right] < target) return right + 1;
        return right;
    }
