//https://leetcode.cn/problems/binary-search/submissions/750517132/

int search(vector<int>& nums, int target) {
        //最基础的二分查找算法
        int left = 0, right = nums.size() - 1, mid;
        while(left <= right){//等于看[5]
            mid = (left + right) / 2;
            if(nums[mid] == target) return mid;
            if(nums[mid] < target) left = mid + 1;//跳过mid（已经不符合，且不加减的话会死循环）
            if(nums[mid] > target) right = mid - 1;
        }
        return -1;
    }
