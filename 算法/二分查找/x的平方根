//https://leetcode.cn/problems/sqrtx/

  int mySqrt(int x) {
        //处理小于1
        if(x < 1){
            return 0;
        }
        int left = 0, right = x;
        while(left < right){
            long long mid = left +(right - left) / 2 + 1;//防止爆数据
            if(mid*mid > x) right = mid - 1;
            else left = mid;
        }
        return left;
    }
