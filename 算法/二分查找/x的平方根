//https://leetcode.cn/problems/sqrtx/
//在模板和区间范围的基础上进行分析（这里只做类型识别，具体看查找区间范围，同一个逻辑）
//首先这里我们有个目标值target，这里定义target是目标值平方后的
//然后就有三个情况，>  =  <  ,这里我们是向下取整，所以对于目标值来说答案在小于等于区间，所以left = mid，同理可得right= mid - 1.最后加上mid更新+1即可
  int mySqrt(int x) {
        //处理小于1
        if(x < 1){
            return 0;
        }
        int left = 0, right = x;
        while(left < right){
            long long mid = left +(right - left) / 2 + 1;//防止爆数据
            if(mid*mid > x) right = mid - 1;
            else left = mid;
        }
        return left;
    }
